# ============================================================
# ENTERPRISE AI BANKING PLATFORM — ENVIRONMENT TEMPLATE
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ----- Application -----
APP_ENV=development                        # development | staging | production
APP_NAME="Enterprise AI Banking Platform"
APP_VERSION=1.0.0
APP_SECRET_KEY=change-me-to-a-random-256-bit-secret

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4                          # Uvicorn worker count (prod: CPU*2+1)
BACKEND_RELOAD=false                       # Hot-reload (dev only)

# ----- Database (PostgreSQL) -----
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=banking_platform
DATABASE_USER=banking_user
DATABASE_PASSWORD=change-me-strong-password
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false                        # Log SQL queries (dev only)

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ----- Logging -----
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                            # json | console
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/banking-platform/app.log

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ----- Nginx -----
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost/api/v1
VITE_APP_NAME="Enterprise AI Banking"
VITE_APP_ENV=development
